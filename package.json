{
  "name": "emporium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-wasm.mjs",
    "setup": "node scripts/setup.mjs && tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@hookform/resolvers": "^7.0.8",
    "@lottiefiles/dotlottie-react": "^0.22.3",
    "animejs": "^4.5.0",
    "better-sqlite3": "^13.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "^14.14.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  }
}
